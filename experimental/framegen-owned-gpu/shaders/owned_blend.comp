#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer A { uint pixel[]; } a;
layout(set=0,binding=1,std430) readonly buffer B { uint pixel[]; } b;
layout(set=0,binding=2,std430) writeonly buffer O { uint pixel[]; } o;
void main() {
 uint i=gl_GlobalInvocationID.x;
 if(i>=1024u) return;
 uint outp=0u;
 for(uint k=0u;k<4u;k++) {
  uint shift=k*8u;
  uint v=(((a.pixel[i]>>shift)&255u)+((b.pixel[i]>>shift)&255u))/2u;
  outp|=v<<shift;
 }
 o.pixel[i]=outp;
}
